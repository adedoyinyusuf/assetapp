# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/asset_management"

# NextAuth Configuration
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL Configuration (if using separate env vars)
PG_USER="postgres"
PG_HOST="localhost"
PG_DATABASE="asset_management"
PG_PASSWORD="your-password"
PG_PORT="5432"

# WebSocket Configuration
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
WS_PORT="3001"

# Redis Configuration (for caching and sessions)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@npc.gov.ng"

# File Upload Configuration
NEXT_PUBLIC_UPLOAD_URL="http://localhost:3000/api/upload"
MAX_FILE_SIZE="10485760" # 10MB in bytes
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,application/pdf"

# Security Configuration
JWT_SECRET="your-jwt-secret-key"
ENCRYPTION_KEY="your-32-character-encryption-key"

# Monitoring and Analytics
NEXT_PUBLIC_ANALYTICS_ID=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""

# Feature Flags
ENABLE_WEBSOCKET="true"
ENABLE_REAL_TIME_UPDATES="true"
ENABLE_ADVANCED_ANALYTICS="true"
ENABLE_AI_SEARCH="true"
ENABLE_NOTIFICATIONS="true"

# Rate Limiting
RATE_LIMIT_WINDOW="900000" # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS="100"

# Logging Configuration
LOG_LEVEL="info"
LOG_FORMAT="json"
ENABLE_REQUEST_LOGGING="true"

# Backup Configuration
BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
BACKUP_RETENTION_DAYS="30"

# External API Keys (if needed)
GOOGLE_MAPS_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# Development Tools
ENABLE_DEBUG_MODE="false"
ENABLE_SWAGGER_UI="false"
ENABLE_PRISMA_STUDIO="true"
